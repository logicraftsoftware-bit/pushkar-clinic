# Private Hostinger environment variables; never commit a real .env.
NODE_ENV=production
MONGODB_URI=mongodb+srv://APPLICATION_USER:URL_ENCODED_PASSWORD@pushkar-clinic.z23i30y.mongodb.net/pushkar_clinic?retryWrites=true&w=majority
MONGODB_DB=pushkar_clinic
FRONTEND_ORIGIN=https://erp.pushkarpharmaceutical.com
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
API_PORT=4000
TRUST_PROXY_HOPS=1
# Hostinger supplies PORT, which takes precedence over API_PORT.

# First deployment only: set privately, then remove after owner login.
# BOOTSTRAP_ADMIN_USERNAME=YOUR_NEW_OWNER_USERNAME
# BOOTSTRAP_ADMIN_PASSWORD=YOUR_NEW_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# BOOTSTRAP_ADMIN_NAME=Clinic Owner

# GROQ_API_KEY=YOUR_PRIVATE_PROVIDER_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
CRM_INTEGRATION_ENABLED=false
# CRM_API_BASE_URL=https://YOUR_CRM_PROVIDER/api

# Leave VITE_API_URL unset: frontend and API use the same origin.
# DATABASE_URL and PostgreSQL settings are not used by the native runtime.
