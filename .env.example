# Local PostgreSQL container
POSTGRES_DB=hospital_erp
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5433

# Backend only. Never expose this value through a VITE_* variable.
DATABASE_URL=postgresql://hospital_app:replace_with_a_long_random_password@localhost:5433/hospital_erp
DATABASE_SSL=false
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_at_least_32_random_characters
# CRM synchronization is temporarily disconnected. Set true only to reconnect.
CRM_INTEGRATION_ENABLED=false

# Backend only. Configure this in the production server environment; never use VITE_*.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# CareFlow360 public API used by Super Admin to select a CRM clinic.
CRM_API_BASE_URL=https://crm.hosmedai.com/api
